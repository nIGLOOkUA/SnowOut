# --- Cocos2d-x Engine ---
/cocos2d/

# --- General Build Outputs & CMake ---
bin/
build/
obj/
out/
cmake-build-*/
CMakeFiles/
CMakeScripts/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json
Makefile

# --- Windows (proj.win32 & MSVC / Visual Studio) ---
Debug.win32/
Release.win32/
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
