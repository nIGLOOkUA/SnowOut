# Intermediate and compiled binary files
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.dll
*.exe
*.aps
*.tlog
*.manifest
*.res

# Release optimizations (LTCG / Whole Program Optimization)
*.iobj
*.ipdb

# MSBuild states and recipes
*.recipe
*.lastbuildstate
*.FileListAbsolute.txt
*.obj.dt.*

# Precompiled Headers (ignore binary cache, keep source Prefix.pch for iOS/macOS)
*.pch
!Prefix.pch

# Memory dumps (generated on game crash)
*.dmp
*.mdmp

